# Give the executing player a Flask of Wondrous Physik.
# Run as the player who should receive the flask.
# Does nothing (silent) if the player already carries one.

# Guard: refuse if the player already carries a Flask of Wondrous Physik
execute if items entity @s container.* minecraft:potion[minecraft:custom_data~{minesouls:{physik_flask:true}}] run return 0

# Give the flask matching the player's currently selected type (ms.physik_type 0-5)
execute if score @s ms.physik_type matches 0 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of Healing","italic":true,"color":"dark_purple"}','{"text":"Regen I (5 min) + Restore ~50% HP","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:0}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
execute if score @s ms.physik_type matches 1 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of Strength","italic":true,"color":"dark_purple"}','{"text":"Regen I + Strength I + Haste I (3 min)","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:1}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
execute if score @s ms.physik_type matches 2 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of Mobility","italic":true,"color":"dark_purple"}','{"text":"Regen I + Jump Boost II + Speed II + Slow Fall (3 min)","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:2}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
execute if score @s ms.physik_type matches 3 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of Defense","italic":true,"color":"dark_purple"}','{"text":"Regen I + Resistance I (3 min)","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:3}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
execute if score @s ms.physik_type matches 4 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of the Elements","italic":true,"color":"dark_purple"}','{"text":"Regen I (3 min) + Fire Res (1 min) + Swim Speed II (3 min)","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:4}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
execute if score @s ms.physik_type matches 5 run give @s minecraft:potion[minecraft:custom_name='{"text":"Flask of Wondrous Physik","italic":false,"color":"light_purple"}',minecraft:lore=['{"text":"Flask of Stealth","italic":true,"color":"dark_purple"}','{"text":"Regen I (3 min) + Invisibility (1 min) + Night Vision (3 min)","italic":false,"color":"gray"}'],minecraft:custom_data={minesouls:{physik_flask:true,physik_type:5}},minecraft:potion_contents={custom_color:10027161},minecraft:item_model:"minesouls:flask_of_wondrous_physik"] 1
